# Copy to .env.dev / .env.staging / .env.production (gitignored).
# Used by scripts/source-terraform-env.sh before plan/apply/destroy.

# AWS account that owns Spot resources + Terraform state
AWS_DEPLOYMENT_ACCOUNT_ID=

# Optional IAM role for Terragrunt/Terraform (leave empty to use the profile directly)
TF_VAR_assume_role_arn=
TG_IAM_ASSUME_ROLE=

# AWS CLI profile (defaults to "spot" in scripts/source-aws-credentials.sh)
AWS_PROFILE=spot
AWS_REGION=eu-west-2
